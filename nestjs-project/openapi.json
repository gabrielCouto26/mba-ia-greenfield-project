    "/videos/{publicId}": {
      "get": {
        "description": "Returns public metadata for a video, including a presigned thumbnail URL when available.",
        "operationId": "VideosController_getVideoInfo",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video metadata",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "public_id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "number",
                      "nullable": true
                    },
                    "thumbnail_url": {
                      "type": "string",
                      "nullable": true
