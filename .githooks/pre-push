#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "🔍 [pre-push] Build + tests..."

echo "  → nestjs-project: tsc"
(cd "$REPO_ROOT/nestjs-project" && ./node_modules/.bin/tsc --noEmit)

echo "  → nestjs-project: build"
(cd "$REPO_ROOT/nestjs-project" && npm run build --silent)

# echo "  → nestjs-project: unit tests"
# (cd "$REPO_ROOT/nestjs-project" && npm test -- --passWithNoTests)

# echo "  → nestjs-project: integration tests"
# (cd "$REPO_ROOT/nestjs-project" && npm run test:integration -- --passWithNoTests)

echo "  → next-frontend: tsc"
(cd "$REPO_ROOT/next-frontend" && ./node_modules/.bin/tsc --noEmit)

# echo "  → next-frontend: unit tests"
# (cd "$REPO_ROOT/next-frontend" && npx vitest run)

echo "✅ [pre-push] OK"
